APP_NAME=AttendanceWeb
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33306
DB_DATABASE=attendance_dev
DB_USERNAME=atd_dev
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173,localhost:5173

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# No real SMTP by default. Configure an approved dev mailbox before sending email.
MAIL_MAILER=array
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME=AttendanceWeb

# Local content validation is not antivirus. Production must use FILE_SCANNER=clamav.
FILE_SCANNER=local_validation
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Opt-in only for an isolated local demo; never enable in production.
DEMO_SEED_ENABLED=false
DEMO_PASSWORD=
