{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "${BACKEND_URL}/api/$1",
      "env": ["BACKEND_URL"],
      "headers": { "Cache-Control": "private, no-store", "CDN-Cache-Control": "no-store" }
    },
    {
      "src": "/sanctum/csrf-cookie",
      "dest": "${BACKEND_URL}/sanctum/csrf-cookie",
      "env": ["BACKEND_URL"],
      "headers": { "Cache-Control": "private, no-store", "CDN-Cache-Control": "no-store" }
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
